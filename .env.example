# =============================================
# CONFIGURACIÓN DEL SERVIDOR
# =============================================
PORT=3000
NODE_ENV=development

# =============================================
# BASE DE DATOS POSTGRESQL
# =============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=online_catalog

# =============================================
# JWT (JSON Web Token)
# =============================================
# Genera un secreto seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_uno_seguro_y_largo
JWT_EXPIRES_IN=24h

# =============================================
# CONFIGURACIÓN DE UPLOADS (opcional)
# =============================================
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=uploads/
